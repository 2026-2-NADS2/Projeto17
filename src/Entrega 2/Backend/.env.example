# ============================================
# Banco de dados MySQL
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=classsync

# Banco na nuvem (SSL): use só UMA das duas opções.
# DB_SSL_CA_PATH: caminho do arquivo ca.pem no seu computador (ex.: C:/classsync/ca.pem)
# DB_SSL_CA: conteúdo do ca.pem colado direto (usado no Render)
# Deixe as duas vazias para usar o MySQL local, sem SSL.
DB_SSL_CA_PATH=
DB_SSL_CA=

# ============================================
# API
# ============================================
# Porta em que a API vai rodar
PORT=3000

# Endereço do frontend publicado, liberado no CORS (ex.: https://classsync.vercel.app)
FRONTEND_URL=

# ============================================
# Autenticação
# ============================================
# Chave secreta usada para assinar os tokens JWT (use um texto longo e aleatório)
JWT_SECRET=

# Administrador inicial, criado pelo script src/scripts/criarAdmin.js
ADMIN_EMAIL=
ADMIN_SENHA=

# Senhas das contas de demonstração criadas pelo script cargaDemonstracao.js
DEMO_SENHA_PROFESSOR=
DEMO_SENHA_RESPONSAVEL=